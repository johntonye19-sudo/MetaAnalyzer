APP_NAME=MetaAnalyzer
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-this-development-secret-at-least-32-characters
DATABASE_URL=postgresql+asyncpg://metaanalyzer:metaanalyzer@postgres:5432/metaanalyzer
REDIS_URL=redis://redis:6379/0
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173
STORAGE_ROOT=/var/lib/metaanalyzer/evidence
MAX_UPLOAD_SIZE_MB=2048
